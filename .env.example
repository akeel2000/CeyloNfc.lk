# Copy to .env at the repo root before running `docker compose up --build` in production.
# Every value here has a dev-only fallback baked into docker-compose.yml (see the
# ${VAR:-default} syntax) so this file is optional for local `docker compose up`, but every
# secret-bearing value below MUST be overridden with a real, unique value in production -
# the fallbacks are intentionally recognizable placeholders, never safe to deploy as-is.

# --- Database ---
DB_NAME=nfc_platform
DB_USERNAME=nfc_app
DB_PASSWORD=change-me-to-a-strong-unique-password
DB_ROOT_PASSWORD=change-me-to-a-strong-unique-root-password
DB_PORT=3307

# --- Redis ---
REDIS_PORT=6379

# --- Backend security (see docs/SECURITY.md) ---
JWT_SECRET=change-me-to-a-random-256-bit-secret-unique-per-environment
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000
NFC_TOKEN_PEPPER=change-me-to-a-random-server-side-pepper-unique-per-environment

# --- URLs (production: https://ceylonfc.com / https://api.ceylonfc.com) ---
SPRING_PROFILES_ACTIVE=docker
APP_FRONTEND_URL=http://localhost:3000
APP_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Required whenever the frontend and backend are on different subdomains of the same domain
# (e.g. ceylonfc.com / api.ceylonfc.com) - shares the CSRF cookie across both so frontend JS can
# read it and echo it back as X-XSRF-TOKEN. Leading dot, no scheme/port: .ceylonfc.com
# Leave blank for single-host local dev (localhost:3000 + localhost:8080 already share cookies).
APP_COOKIE_DOMAIN=

# --- Media storage ---
STORAGE_TYPE=local

# --- Optional: only used once, on first startup, to seed the initial Super Admin account.
# Leave unset in production after the first account has been created - see
# docs/PROJECT_PROGRESS.md "How to run it yourself" for why these are dev-only env vars,
# never a persisted admin account setup path. ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
