# Copy to .env and fill in local values. Never commit the real .env file.

DB_HOST=localhost
DB_PORT=3307
DB_NAME=nfc_platform
DB_USERNAME=nfc_app
DB_PASSWORD=nfc_app_password

JWT_SECRET=change-me-to-a-random-256-bit-secret-in-every-environment
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000
NFC_TOKEN_PEPPER=change-me-to-a-random-server-side-pepper

# Local dev values shown; production: https://ceylonfc.com / https://api.ceylonfc.com
APP_FRONTEND_URL=http://localhost:3000
APP_BACKEND_URL=http://localhost:8080
APP_COOKIE_DOMAIN=

STORAGE_TYPE=local
STORAGE_PATH=./media

# Only read when STORAGE_TYPE=s3. Works against real AWS S3 (leave STORAGE_S3_ENDPOINT unset,
# leave keys unset to use the SDK's default credential chain / IAM role) or any S3-compatible
# provider (MinIO, Cloudflare R2, DigitalOcean Spaces...) via STORAGE_S3_ENDPOINT.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_PUBLIC_URL=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ceylonfc.com

REDIS_HOST=localhost
REDIS_PORT=6379

# Optional: only used once, on first startup, to seed the initial Super Admin account.
# Leave unset in production after the first account has been created.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
